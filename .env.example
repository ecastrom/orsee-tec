# ------------------------------------------------------------------------
# BEER Lab / ORSEE environment template.
# Copy to .env (which is git-ignored) and fill in. Used by docker-compose.
# On Heroku you set these as "config vars" instead (see DEPLOYMENT.md).
# ------------------------------------------------------------------------

# --- Docker MySQL service credentials ---
MYSQL_DATABASE=orsee
MYSQL_USER=orsee
MYSQL_PASSWORD=change_me_db_pw
MYSQL_ROOT_PASSWORD=change_me_root_pw

# --- Web ---
WEB_PORT=8080
ORSEE_SERVER_URL=localhost:8080
ORSEE_SERVER_PROTOCOL=http://
ORSEE_TIMEZONE=America/Monterrey

# --- Outgoing email (optional for local; required to actually send mail) ---
# For local testing you can leave transport as "mail" (no real delivery).
# To send real email set transport to "phpmailer" and fill the SMTP block.
ORSEE_MAIL_TRANSPORT=mail
ORSEE_SMTP_HOST=
ORSEE_SMTP_PORT=587
ORSEE_SMTP_SECURE=tls
ORSEE_SMTP_USER=
ORSEE_SMTP_PASS=

# --- Self-hosting: Cloudflare Tunnel (only for docker-compose.tunnel.yml) ---
# Token from the Cloudflare Zero Trust dashboard for your named tunnel.
# When set, remember to also set ORSEE_SERVER_URL/PROTOCOL above to your public
# domain (e.g. beerlab.example.org / https://). See bin/self-host.md.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups (bin/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Optional off-site copy via a configured rclone remote (e.g. gdrive:orsee-backups).
BACKUP_RCLONE_REMOTE=
